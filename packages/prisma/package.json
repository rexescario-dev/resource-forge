{
  "name": "@resource-forge/prisma",
  "version": "0.0.0",
  "description": "Prisma correspondence verification, schema realization, and Client persistence bindings for Resource Forge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@resource-forge/core": "workspace:*"
  }
}
